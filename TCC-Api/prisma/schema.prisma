// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EntryType {
  income
  expenses
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now()) @map("created_at")

  entries    Entry[]
  categories Category[]
  goals      Goal[]

  @@map("user")
}

model Entry {
  id          String    @id @default(uuid())
  title       String
  description String?
  value       Float
  type        EntryType
  date        DateTime
  createdAt   DateTime  @default(now()) @map("created_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  categoryId String?   @map("category_id")
  category   Category? @relation(fields: [categoryId], references: [id])

  goalId String? @map("goal_id")
  goal   Goal?   @relation(fields: [goalId], references: [id])

  isFixed  Boolean @default(false)
  fixedDay Int?    @map("fixed_day")
  parentId String? @map("parent_id")

  @@map("entry")
}

model Category {
  id          String   @id @default(uuid())
  name        String
  description String?
  color       String?  @db.Char(6)
  // icon String?  Fezin ira analisar as condições
  createdAt   DateTime @default(now()) @map("created_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  entries Entry[]

  @@unique([userId, name])
  @@map("category")
}

model Goal {
  id          String   @id @default(uuid())
  title       String
  description String?
  value       Float
  limitDate   DateTime
  createdAt   DateTime @default(now()) @map("created_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  entries Entry[]

  @@map("goal")
}
